% poisson2d — the 2-D Poisson equation −∇·(c ∇φ) = s on a rectangular grid: electrostatics (φ potential,
%             c permittivity ε, s charge density) and anything of the same form (A_z in magnetostatics, a membrane,
%             steady 2-D conduction, potential flow)
%
% Usage:      r = poisson2d(m, c, s, bc)
%             r = poisson2d(m, c, s, bc, opts)
%   m         a quadGrid mesh (quadGrid(Lx, Ly, nx, ny, origin): equal rectangles; node n = i + (nx+1)·j + 1,
%             element e = i + nx·j + 1, i along x first; nodes_at(m, 1|2, value) picks grid lines)
%   c         the coefficient: one number, or one per element (ε in F/m: ε0 = 8.8541878128e-12, × εr)
%   s         the source per unit area: one number, or one per element (charge density, C/m³)
%   bc        struct: bc.fixed = { struct('nodes', n, 'value', V), … } (fixed potentials; electrodes are groups)
%             Edges with no fixed value are natural (c ∂φ/∂n = 0: no flux crosses them, field lines run along).
%   opts      struct, optional: show (true), name ('potential'), load (nodes × 1: an extra load added to the
%             right-hand side as it is, e.g. magnetostatic2d's permanent magnets; 0.6 SG.7+)
% Returns:    r.phi (nodes × 1), r.grad (elements × 2: ∇φ at the element centres), r.flux (elements × 2:
%             −c∇φ, the field D = εE for electrostatics), r.energy (½ φᵀKφ = ½∫c|∇φ|² per unit depth, J/m),
%             r.charge (one per bc.fixed group: Σ(Kφ − f) over its nodes = the charge on that electrode per unit
%             depth, C/m), r.mesh, r.fields {potential (node), field −∇φ (element, 3 components, z = 0)}.
% Method:     4-node bilinear elements; on an a × b rectangle the element matrix is closed form,
%             Ke = c/6 · [ (b/a)·Kx + (a/b)·Ky ] with Kx, Ky the 4×4 patterns below (Zienkiewicz & Taylor vol. 1);
%             assembled for every element with its own c by assemble(edofs, Ke, c); loads s·a·b/4 per corner;
%             fixed values moved to the right-hand side; φ_free = K_ff \ (f − K_fc φ_c) (envelope Cholesky).
% Units:      SI (m, V, F/m, C/m³) for electrostatics; any consistent set otherwise.
% Assumes:    linear, isotropic c; 2-D: nothing changes along z (results per metre of depth).
% Limits:     a rectangular grid of equal elements (refine everywhere, not locally); fields are singular at
%             electrode edges — read capacitance from the energy or charge, not from the edge field.
% References: O. C. Zienkiewicz, R. L. Taylor, The Finite Element Method vol. 1 (6th ed.) §6.2 (Poisson, bilinear
%             rectangle); J. D. Jackson, Classical Electrodynamics (3rd ed.) §1.11 (energy, W = ½CV²);
%             parallel plates C' = ε w / d per unit depth; fringing: H. B. Palmer, "The capacitance of a
%             parallel-plate capacitor by the Schwartz-Christoffel transformation", Trans. AIEE 56 (1937) 363,
%             C' ≈ (ε w / d)·[1 + d/(πw)·(1 + ln(2πw/d))].
% Check:      plates spanning the domain (no fringing): C' = ε0 w/d to 1e-9; plates w = 4 d inside a 16 d box:
%             C' above ε0 w/d by fringing and within 3 % of Palmer's formula (bin/test-craftscript.mjs --lib).
function r = poisson2d(m, c, s, bc, opts)
if nargin < 5
  opts = struct();
end
info = meshInfo(m);
if ~strcmp(info.kind, 'quad')
  error('poisson2d: a quadGrid mesh is needed (got %s)', info.kind);
end
X = meshNodes(m);
Q = meshElems(m);
nn = info.nodes; ne = info.elements;
a = X(Q(1, 2), 1) - X(Q(1, 1), 1);             % element width (x)
b = X(Q(1, 4), 2) - X(Q(1, 1), 2);             % element height (y)
Kx = [ 2 -2 -1  1; -2  2  1 -1; -1  1  2 -2;  1 -1 -2  2];
Ky = [ 2  1 -1 -2;  1  2 -2 -1; -1 -2  2  1; -2 -1  1  2];
Ke = ((b / a) * Kx + (a / b) * Ky) / 6;         % unit coefficient, nodes (0,0) (a,0) (a,b) (0,b)
ce = c(:) .* ones(ne, 1);
K = assemble(Q, Ke, ce, nn);
se = s(:) .* ones(ne, 1);
f = accumarray(Q(:), repmat(se * a * b / 4, 4, 1), [nn 1]);
ld = getopt(opts, 'load', []);
if ~isempty(ld)
  f = f + ld(:);
end

phi = zeros(nn, 1);
fixed = []; vals = [];
groups = getopt(bc, 'fixed', {});
for k = 1:numel(groups)
  nd = groups{k}.nodes(:);
  fixed = [fixed; nd];
  vals = [vals; groups{k}.value * ones(numel(nd), 1)];
end
[fixed, iu] = unique(fixed);
vals = vals(iu);
phi(fixed) = vals;
free = setdiff((1:nn)', fixed);
rhs = f(free);
if ~isempty(fixed)
  rhs = rhs - K(free, fixed) * vals;
end
phi(free) = K(free, free) \ rhs;

% fields at the element centres
P = phi(Q);
gx = P * ([-1 1 1 -1]' / (2 * a));
gy = P * ([-1 -1 1 1]' / (2 * b));
R = K * phi - f;
r = struct();
r.phi = phi;
r.grad = [gx gy];
r.flux = -[ce .* gx, ce .* gy];
r.energy = 0.5 * phi' * (K * phi);
r.charge = zeros(1, numel(groups));
for k = 1:numel(groups)
  r.charge(k) = sum(R(groups{k}.nodes(:)));
end
r.mesh = m;
name = getopt(opts, 'name', 'potential');
r.fields = {field(m, phi, 'node', name), field(m, [-gx, -gy, zeros(ne, 1)], 'elem', ['-grad ' name])};
if getopt(opts, 'show', true)
  show(r.fields{1}, 'name', ['poisson2d: ' name]);
end
end

function v = getopt(s, name, default)
if isfield(s, name)
  v = s.(name);
else
  v = default;
end
end
