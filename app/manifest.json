{
  "app": "partcraft",
  "css": [
    "partcraft.css",
    "laser/laser-panel.css"
  ],
  "module": "partcraft.js",
  "imports": {
    "three": "/assets/vendor/three/current/three.module.js",
    "three/addons/": "/assets/vendor/three/current/addons/",
    "manifold-3d": "/assets/vendor/manifold-3d/current/manifold.js",
    "@noble/curves/": "/assets/vendor/noble-curves/current/",
    "@noble/hashes/": "/assets/vendor/noble-hashes/current/",
    "@noble/ciphers/": "/assets/vendor/noble-ciphers/current/"
  },
  "phone": true,
  "panels": [
    "move",
    "window"
  ],
  "isolate": "require-corp",
  "addons": "own",
  "accepts": [
    "live"
  ],
  "input": "input-partcraft.js",
  "workspaces": {
    "layouts": [
      "docked",
      "toolbox"
    ],
    "adapter": "workspace-partcraft.js"
  },
  "hardware": true
}
